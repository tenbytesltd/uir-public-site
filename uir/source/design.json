      "role": "list",
      "salience": "supporting"
    },
    {
      "content": "01 — New UI — Capture approved design decisions as UIR.",
      "controls": null,
      "id": "uir-site:node:build-step-1",
      "key": "build-step-1",
      "order": 0,
      "parent": "build-steps",
      "role": "listitem",
      "salience": "supporting"
    },
    {
      "content": "02 — Existing UI — Extract what the frontend can prove and keep the gaps explicit.",
      "controls": null,
      "id": "uir-site:node:build-step-2",
      "key": "build-step-2",
      "order": 1,
      "parent": "build-steps",
      "role": "listitem",
      "salience": "supporting"
    },
    {
      "content": "03 — Any implementation — Use people, agents, frameworks, or any combination to produce the frontend.",
      "controls": null,
      "id": "uir-site:node:build-step-3",
      "key": "build-step-3",
      "order": 2,
      "parent": "build-steps",
      "role": "listitem",
      "salience": "supporting"
    },
    {
      "content": "04 — Every change — Verify the result against the same specification.",
      "controls": null,
      "id": "uir-site:node:build-step-4",
      "key": "build-step-4",
      "order": 3,
      "parent": "build-steps",
      "role": "listitem",
      "salience": "supporting"
    },
    {
